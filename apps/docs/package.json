{
  "name": "@genoffice/docs",
  "productName": "ForaOffice Docs",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "AI-native streaming docx editor with paragraph-patch save",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "build:embedded": "vite build --config vite.embedded.config.ts",
    "build:services": "node build-services.mjs",
    "build:sdk": "node build-sdk.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/ai-search": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/file-parse": "*",
    "@genoffice/i18n": "*",
    "@genoffice/project-store": "*",
    "@genoffice/ui": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tiptap/core": "3.31.0",
    "@tiptap/extensions": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dts-bundle-generator": "9.5.1",
    "electron": "^43.8.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^28.0.0",
    "marked": "^17.0.6",
    "opentype.js": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "author": "ForaOffice contributors",
  "build": {
    "appId": "com.foraoffice.docs",
    "productName": "ForaOffice Docs",
    "electronVersion": "43.3.0",
    "artifactName": "AIDocx-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "role": "Editor"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/electron-utils": "*",
    "@genoffice/font-metrics": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/xlsx-gateway": "*",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanbingtech/foraoffice.git"
  },
  "homepage": "https://github.com/lanbingtech/foraoffice",
  "bugs": {
    "url": "https://github.com/lanbingtech/foraoffice/issues"
  },
  "foraoffice": {
    "modifiedFrom": "GenOffice v0.12.852",
    "modifications": "Fork product identity, source/support routing and Docs SDK delivery"
  }
}
